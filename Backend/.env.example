# Server
PORT=3002
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=smart_hrms_attendance

# JWT
JWT_SECRET=change_me_to_a_random_string

# Redis (optional, falls back to localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS - comma-separated origins for production
CORS_ORIGINS=http://localhost:5173

# Device API key (required in production)
DEVICE_API_KEY=change_me

# Rate Limiting (tiered per HTTP method)
API_READ_LIMIT=1000
API_WRITE_LIMIT=300
API_RATE_WINDOW_MINUTES=15

# Worker
WORKER_ENABLED=true
